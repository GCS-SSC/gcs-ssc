{
  "name": "gcs-ssc",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:extension-sdk && bun run build:app",
    "build:demo": "VITE_GCS_DEMO=true NITRO_PRESET=node-server bun run build",
    "build:app": "bun run scripts/nuxt-artifact-lock.ts -- bun run build:app:unlocked",
    "build:app:unlocked": "bun run scripts/build-nuxt-with-warning-gate.ts && bun build server/workers/admin-sql-dump.ts --target node --format esm --external '@electric-sql/*' --external kysely --outfile .output/server/admin-sql-dump-worker.mjs && bun run scripts/build-storage-cleanup-worker.ts",
    "storage:cleanup:drain": "bun run server/workers/storage-cleanup-drain.ts",
    "build:extension-sdk": "bun run --cwd packages/gcs-ssc-extensions build",
    "dev": "bun run scripts/dev.ts",
    "dev:clean": "bun run scripts/dev.ts --clean",
    "data-model:sheet:read": "bun run scripts/read-data-model-spreadsheet.ts",
    "data-model:sheet:authorize": "bun run scripts/authorize-google-sheets.ts",
    "data-model:sheet:cell:update": "bun run scripts/data-model-spreadsheet-row.ts cell",
    "data-model:sheet:row:read": "bun run scripts/data-model-spreadsheet-row.ts read",
    "data-model:sheet:row:update": "bun run scripts/data-model-spreadsheet-row.ts update",
    "data-model:sheet:row:insert": "bun run scripts/data-model-spreadsheet-row.ts insert",
    "data-model:sheet:row:delete": "bun run scripts/data-model-spreadsheet-row.ts delete",
    "data-model:sheet:row:color": "bun run scripts/data-model-spreadsheet-row.ts color",
    "data-model:sheet:row:move": "bun run scripts/data-model-spreadsheet-row.ts move",
    "bun:docgen:install": "bun run scripts/setup-docgen-tools.ts",
    "setup": "bun run scripts/setup-workspaces.ts",
    "tooling:setup": "bun run scripts/setup-private-tooling.ts",
    "tooling:update": "git submodule update --init --remote -- tooling/gcs-ssc && bun run tooling:setup",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "repos:update": "git pull --recurse-submodules && git submodule sync --recursive && git submodule update --init --recursive --remote",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "quality:changed": "bash .agents/skills/gcs-ssc/scripts/changed-files.sh",
    "quality:fallow": "mkdir -p .agent/reports/whole && fallow --summary > .agent/reports/whole/fallow-summary.txt || true",
    "quality:deps": "bash .agents/skills/gcs-ssc/scripts/dependency-reports.sh json",
    "quality:deps:graph": "bash .agents/skills/gcs-ssc/scripts/dependency-reports.sh dot",
    "quality:lint:fast": "bun run lint && oxlint --ignore-pattern 'extensions/*/client/worker.js' --ignore-pattern 'extensions/*/client/ort-*' .",
    "quality:artifact": "bun run scripts/test-production-artifact.ts",
    "quality:webcontainer": "bun x playwright install chromium && bun run build:demo && bun run scripts/webcontainer.ts --from-output --stage-demo .output .agent/reports/webcontainer-preview && bun run scripts/test-webcontainer-artifact.ts .agent/reports/webcontainer-output .agent/reports/webcontainer-preview",
    "quality:scan": "bash .agents/skills/gcs-ssc/scripts/quality-whole.sh",
    "quality:whole": "bash .agents/skills/gcs-ssc/scripts/quality-whole.sh",
    "quality:whole:ledger": "bash .agents/skills/gcs-ssc/scripts/run-whole-review-ledger-pipeline.sh",
    "quality:whole:resume-manifest": "bun run .agents/skills/gcs-ssc/scripts/write-whole-review-resume-manifest.ts",
    "quality:pr": "bash .agents/skills/gcs-ssc/scripts/quality-pr.sh",
    "review:fallow:agent": "fallow audit --gate new-only --format json --quiet --explain",
    "review:fallow:broad": "fallow --format json --quiet --summary",
    "review:fallow:human": "fallow audit --gate new-only --format human",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun x vitest run",
    "test:integration:postgres": "bun run scripts/test-postgres.ts",
    "test:integration:postgres:root": "bun x vitest run --config vitest.postgres.config.ts",
    "test:coverage": "bun x vitest run --coverage",
    "test:coverage:host-critical": "bun run test:coverage:host:workflow && bun run test:coverage:host:extension-lifecycle",
    "test:coverage:host:workflow": "bun x vitest run --coverage --config vitest.workflow-runtime.config.ts",
    "test:coverage:host:extension-lifecycle": "bun x vitest run --coverage --config vitest.extension-lifecycle-runtime.config.ts",
    "test:production-artifact": "bun run quality:artifact",
    "test:webcontainer:artifact": "bun run quality:webcontainer",
    "test:e2e": "bun run scripts/test-e2e.ts --suite pglite",
    "test:e2e:pglite": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite pglite",
    "test:e2e:pglite:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite pglite --spec",
    "test:e2e:amendment-refresh": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite amendment-refresh",
    "test:e2e:amendment-refresh:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite amendment-refresh --spec",
    "test:e2e:agreement-closeout": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite agreement-closeout",
    "test:e2e:agreement-closeout:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite agreement-closeout --spec",
    "test:e2e:workflow-recommendation": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite workflow-recommendation",
    "test:e2e:workflow-recommendation:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite workflow-recommendation --spec",
    "test:e2e:workflow-setup-retired": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite workflow-setup-retired",
    "test:e2e:workflow-setup-retired:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite workflow-setup-retired --spec",
    "test:e2e:agreement-amendments": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite agreement-amendments",
    "test:e2e:agreement-amendments:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite agreement-amendments --spec",
    "test:e2e:attachments": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite attachments",
    "test:e2e:attachments:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite attachments --spec",
    "test:e2e:agency-statuses": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite agency-statuses",
    "test:e2e:agency-statuses:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite agency-statuses --spec",
    "test:e2e:fresh-reset": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e-fresh-reset.ts",
    "test:e2e:fresh-reset:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e-fresh-reset.ts --spec",
    "test:e2e:postgres": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite postgres",
    "test:e2e:postgres:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite postgres --spec",
    "test:e2e:review-scratch": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite review-scratch",
    "test:e2e:review-scratch:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite review-scratch --spec",
    "test:e2e:light": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite pglite",
    "test:e2e:light:spec": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite pglite --spec",
    "test:e2e:fast": "PLAYWRIGHT_WORKERS=1 bun run scripts/test-e2e.ts --suite pglite",
    "test:all:manual": "bun run lint && bun run typecheck && bun run test:coverage && bun run test:integration:postgres && bun run test:e2e:pglite && bun run test:e2e:amendment-refresh && bun run test:e2e:agreement-closeout && bun run test:e2e:workflow-recommendation && bun run test:e2e:workflow-setup-retired && bun run test:e2e:agreement-amendments && bun run test:e2e:attachments && bun run test:e2e:agency-statuses && bun run test:e2e:fresh-reset && bun run test:e2e:postgres",
    "webcontainer:preview": "bun scripts/webcontainer.ts --stage-demo && npx serve .agent/reports/webcontainer-preview"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.5.0-beta.9",
    "@electric-sql/pglite": "0.3.16",
    "@electric-sql/pglite-tools": "0.2.21",
    "@fastify/busboy": "^3.2.2",
    "@gcs-ssc/authorization": "workspace:*",
    "@gcs-ssc/extensions": "workspace:*",
    "@iconify-json/lucide": "^1.2.89",
    "@iconify-json/simple-icons": "^1.2.70",
    "@internationalized/date": "^3.11.0",
    "@intlify/h3": "0.7.4",
    "@nuxt/schema": "^4.3.1",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@tanstack/table-core": "^8.21.3",
    "@tanstack/vue-table": "^8.21.3",
    "@types/node": "^25.3.0",
    "@vueuse/core": "^14.2.0",
    "@vueuse/nuxt": "^14.2.0",
    "better-auth": "^1.4.18",
    "content-disposition": "^2.0.0",
    "docxtemplater": "^3.68.7",
    "fuse.js": "^7.1.0",
    "h3": "1.15.5",
    "jiti": "^2.6.1",
    "kysely": "^0.28.11",
    "kysely-pglite": "^0.6.1",
    "libreoffice-convert": "^1.8.1",
    "nanoid": "^5.1.6",
    "nuxt": "^4.3.1",
    "ofetch": "^1.5.1",
    "pg": "^8.18.0",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.43.1",
    "scule": "^1.3.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vue/compiler-dom": "^3.5.28",
    "@vue/compiler-sfc": "^3.5.28",
    "@intlify/eslint-plugin-vue-i18n": "^4.1.1",
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/kit": "^4.3.1",
    "@playwright/test": "^1.58.2",
    "@types/pg": "^8.16.0",
    "@types/picomatch": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.0.0",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "fallow": "^2.74.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.65.0",
    "picomatch": "^4.0.5",
    "playwright": "^1.58.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "bun@1.3.13"
}
