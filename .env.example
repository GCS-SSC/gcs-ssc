ENVIRONMENT_TYPE=demo

# PostgreSQL only. Leave DATABASE_URL unset to use PGlite.
# DATABASE_URL=postgresql://gcs_ssc:change-me@127.0.0.1:5432/gcs_ssc
# Required with DATABASE_URL: a separate PostgreSQL instance (not another database on the same server).
# GCS_ACCESS_DATABASE_URL=postgresql://gcs_access:change-me@127.0.0.1:5433/gcs_access
# PGlite development uses a second database, defaulting to ${PGLITE_DATA_DIR}-access.
# PGLITE_ACCESS_DATA_DIR=./.data/pglite-access
# POSTGRES_STATEMENT_TIMEOUT_MS=60000
# POSTGRES_LOCK_TIMEOUT_MS=5000
# POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
# POSTGRES_HEALTH_QUERY_TIMEOUT_MS=2000

# Access query logs only; change/security auditing remains enabled. Restart after changing.
# Defaults to true when unspecified. Only true/false are accepted.
# GCS_ACCESS_LOG_ENABLED=true
# Maximum batches of 100 writes per ten-second timer tick, per app worker (1..100).
# GCS_ACCESS_LOG_MAX_BATCHES_PER_FLUSH=10
