# Bun loads this file after copying it to infra/aws/.env.
# Select a configured AWS CLI profile, or leave commented to use default credentials.
# AWS_PROFILE=your-profile
AWS_REGION=ca-central-1

# Optional account-wide budget notifications; alerts do not cap spending.
# AWS_BUDGET_EMAIL=you@example.com
AWS_MONTHLY_BUDGET_USD=200

# Prefer AWS SSO / profiles. If temporary credentials are necessary, keep them
# only in .env, never in this example or CDK context.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
